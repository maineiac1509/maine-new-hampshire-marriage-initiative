{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "title": "Volunteer Team"
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "display_name": {
      "type": "string",
      "title": "Display Name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "team_role": {
      "type": "string",
      "title": "Team Role",
      "enum": [
        "Lead",
        "Member"
      ],
      "default": "Member"
    }
  },
  "required": [
    "team_id",
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    }
  }
}
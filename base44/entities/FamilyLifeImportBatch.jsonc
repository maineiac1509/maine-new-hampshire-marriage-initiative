{
  "name": "FamilyLifeImportBatch",
  "type": "object",
  "title": "FamilyLife Import Batch",
  "description": "Represents one uploaded FamilyLife file and its complete staging and apply lifecycle.",
  "properties": {
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "original_file_name": {
      "type": "string",
      "title": "Original File Name"
    },
    "file_type": {
      "type": "string",
      "title": "File Type",
      "enum": [
        "csv",
        "xlsx",
        "xls",
        "pasted",
        "unknown"
      ],
      "default": "unknown"
    },
    "file_size": {
      "type": "number",
      "title": "File Size (bytes)"
    },
    "file_hash": {
      "type": "string",
      "title": "Content Signature Hash",
      "description": "Deterministic signature over filename, row count, source period, and normalized content. Used for duplicate-file detection."
    },
    "status": {
      "type": "string",
      "title": "Batch Status",
      "enum": [
        "UPLOADED",
        "PARSING",
        "STAGED",
        "COMPARING",
        "READY_FOR_REVIEW",
        "READY_TO_APPLY",
        "APPLYING",
        "PROCESSING_FAILED",
        "DISCARDED",
        "APPLIED"
      ],
      "default": "UPLOADED"
    },
    "source_period": {
      "type": "string",
      "title": "Source Period / Year",
      "description": "e.g. '2025' or '2025-Q3'. Helps identify the annual import cycle."
    },
    "processing_started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Processing Started At"
    },
    "processing_completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Processing Completed At"
    },
    "total_rows": {
      "type": "number",
      "title": "Total Source Rows",
      "default": 0
    },
    "valid_rows": {
      "type": "number",
      "title": "Valid Rows",
      "default": 0
    },
    "invalid_rows": {
      "type": "number",
      "title": "Invalid Rows",
      "default": 0
    },
    "matched_rows": {
      "type": "number",
      "title": "Matched Rows",
      "default": 0
    },
    "unmatched_rows": {
      "type": "number",
      "title": "Unmatched Rows",
      "default": 0
    },
    "new_record_rows": {
      "type": "number",
      "title": "New Record Rows",
      "default": 0
    },
    "possible_duplicate_rows": {
      "type": "number",
      "title": "Possible Duplicate Rows",
      "default": 0
    },
    "no_change_rows": {
      "type": "number",
      "title": "No-Change Rows",
      "default": 0
    },
    "safe_update_rows": {
      "type": "number",
      "title": "Safe Update Rows",
      "default": 0
    },
    "conflict_rows": {
      "type": "number",
      "title": "Conflict Rows",
      "default": 0
    },
    "blocked_field_count": {
      "type": "number",
      "title": "Blocked Field Count",
      "default": 0
    },
    "warning_count": {
      "type": "number",
      "title": "Warning Count",
      "default": 0
    },
    "error_count": {
      "type": "number",
      "title": "Error Count",
      "default": 0
    },
    "blocking_error_count": {
      "type": "number",
      "title": "Blocking Error Count",
      "default": 0
    },
    "governance_version": {
      "type": "string",
      "title": "Governance Version",
      "description": "Version identifier of the field governance contract used during processing."
    },
    "mapping_version": {
      "type": "string",
      "title": "Mapping Version",
      "description": "Version identifier of the source column mapping logic used."
    },
    "summary": {
      "type": "object",
      "title": "Batch Summary",
      "description": "Aggregate statistics and administrator-readable summary of the staged import.",
      "properties": {
        "restrictive_preferences_added": {
          "type": "number"
        },
        "protected_fields_ignored": {
          "type": "number"
        },
        "unknown_fields_blocked": {
          "type": "number"
        },
        "unmapped_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields_imported": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "default": {}
    },
    "possible_duplicate_batch_id": {
      "type": "string",
      "title": "Possible Duplicate Batch",
      "description": "If a prior batch with the same content signature is detected, references that batch. Null otherwise."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "title": "Archived At"
    },
    "archived_by": {
      "type": "string",
      "title": "Archived By"
    },
    "failure_reason": {
      "type": "string",
      "title": "Failure Reason",
      "description": "If status is PROCESSING_FAILED, the reason processing stopped."
    },
    "readiness_status": {
      "type": "string",
      "title": "Readiness Status",
      "enum": [
        "NOT_READY",
        "READY_TO_APPLY",
        "STALE_GOVERNANCE",
        "STALE_MAPPING"
      ],
      "default": "NOT_READY",
      "description": "Deterministic readiness check result. READY_TO_APPLY only when all required decisions are complete and governance/mapping versions still match."
    },
    "readiness_reason": {
      "type": "string",
      "title": "Readiness Reason",
      "description": "Human-readable explanation of why the batch is not ready, or empty if ready."
    },
    "ready_to_apply_at": {
      "type": "string",
      "format": "date-time",
      "title": "Ready To Apply At"
    },
    "ready_to_apply_by": {
      "type": "string",
      "title": "Ready To Apply By",
      "description": "User ID of the administrator who confirmed readiness."
    },
    "resolution_summary": {
      "type": "object",
      "title": "Resolution Summary",
      "description": "Aggregate resolution progress statistics computed during the resolution workflow.",
      "properties": {
        "total_actionable": {
          "type": "number",
          "default": 0
        },
        "auto_resolved": {
          "type": "number",
          "default": 0
        },
        "manually_resolved": {
          "type": "number",
          "default": 0
        },
        "pending_conflicts": {
          "type": "number",
          "default": 0
        },
        "unresolved_matches": {
          "type": "number",
          "default": 0
        },
        "blocking_issues": {
          "type": "number",
          "default": 0
        },
        "proposed_new_records": {
          "type": "number",
          "default": 0
        },
        "discarded_records": {
          "type": "number",
          "default": 0
        },
        "completion_percentage": {
          "type": "number",
          "default": 0
        }
      },
      "default": {}
    },
    "applying_started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Applying Started At",
      "description": "Timestamp when the apply engine acquired the lock on this batch."
    },
    "applying_started_by": {
      "type": "string",
      "title": "Applying Started By",
      "description": "User ID of the administrator who initiated the apply."
    },
    "apply_execution_id": {
      "type": "string",
      "title": "Apply Execution ID",
      "description": "Unique identifier for the current or most recent apply execution. Prevents concurrent applies and enables idempotent resume."
    },
    "applied_at": {
      "type": "string",
      "format": "date-time",
      "title": "Applied At",
      "description": "Timestamp when the batch was successfully applied to production (post-apply verification passed)."
    },
    "applied_by": {
      "type": "string",
      "title": "Applied By",
      "description": "User ID of the administrator who completed the apply."
    },
    "apply_status": {
      "type": "string",
      "title": "Apply Status",
      "enum": [
        "PENDING",
        "APPLYING",
        "PAUSED",
        "APPLIED",
        "FAILED",
        "PARTIALLY_FAILED"
      ],
      "default": "PENDING",
      "description": "Status of the production apply engine for this batch. PENDING = not started. APPLYING = chunk in progress. PAUSED = between chunks, safe to resume. APPLIED = verified and complete. FAILED/PARTIALLY_FAILED = apply encountered errors."
    },
    "apply_phase": {
      "type": "string",
      "title": "Apply Phase",
      "enum": [
        "PREVALIDATED",
        "CREATING_HOUSEHOLDS",
        "CREATING_MEMBERS",
        "UPDATING_HOUSEHOLDS",
        "UPDATING_MEMBERS",
        "APPLYING_RESTRICTIONS",
        "RECORDING_DECISIONS",
        "VERIFYING",
        "FINALIZING",
        "COMPLETED"
      ],
      "default": "PREVALIDATED",
      "description": "Current execution phase in the chunked apply pipeline."
    },
    "apply_progress": {
      "type": "object",
      "title": "Apply Progress Checkpoint",
      "description": "Running progress tracker for the chunked apply engine. Updated after every chunk.",
      "properties": {
        "total_operations": {
          "type": "number",
          "default": 0
        },
        "pending": {
          "type": "number",
          "default": 0
        },
        "applied": {
          "type": "number",
          "default": 0
        },
        "verified": {
          "type": "number",
          "default": 0
        },
        "failed": {
          "type": "number",
          "default": 0
        },
        "skipped": {
          "type": "number",
          "default": 0
        },
        "percent_complete": {
          "type": "number",
          "default": 0
        },
        "chunk_index": {
          "type": "number",
          "default": 0
        },
        "last_checkpoint_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "default": {}
    },
    "apply_error": {
      "type": "string",
      "title": "Apply Error",
      "description": "If apply_status is FAILED or PARTIALLY_FAILED, the summary error description."
    },
    "apply_summary": {
      "type": "object",
      "title": "Apply Summary",
      "description": "Post-apply production outcome statistics, populated after successful or partial application.",
      "properties": {
        "preflight_passed": {
          "type": "boolean",
          "default": false
        },
        "drift_blocked_count": {
          "type": "number",
          "default": 0
        },
        "restrictions_added": {
          "type": "number",
          "default": 0
        },
        "fields_skipped": {
          "type": "number",
          "default": 0
        },
        "fields_blocked": {
          "type": "number",
          "default": 0
        },
        "keep_current_count": {
          "type": "number",
          "default": 0
        },
        "custom_values_applied": {
          "type": "number",
          "default": 0
        },
        "verification_passed": {
          "type": "boolean"
        }
      },
      "default": {}
    },
    "created_household_count": {
      "type": "number",
      "title": "Created Household Count",
      "default": 0
    },
    "updated_household_count": {
      "type": "number",
      "title": "Updated Household Count",
      "default": 0
    },
    "created_member_count": {
      "type": "number",
      "title": "Created Member Count",
      "default": 0
    },
    "updated_member_count": {
      "type": "number",
      "title": "Updated Member Count",
      "default": 0
    },
    "skipped_row_count": {
      "type": "number",
      "title": "Skipped Row Count",
      "default": 0
    },
    "failed_row_count": {
      "type": "number",
      "title": "Failed Row Count",
      "default": 0
    },
    "applied_field_count": {
      "type": "number",
      "title": "Applied Field Count",
      "default": 0
    }
  },
  "required": [
    "file_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
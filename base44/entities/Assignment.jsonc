{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "household_id": {
      "type": "string",
      "title": "Champion"
    },
    "volunteer_team_id": {
      "type": "string",
      "title": "Volunteer Team"
    },
    "assigned_by": {
      "type": "string",
      "title": "Assigned By"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "title": "Assigned Date"
    },
    "assignment_method": {
      "type": "string",
      "title": "Assignment Method",
      "enum": [
        "Manual",
        "Recommendation",
        "Auto Assignment"
      ],
      "default": "Manual"
    },
    "assignment_status": {
      "type": "string",
      "title": "Assignment Status",
      "enum": [
        "Active",
        "On Hold",
        "Closed"
      ],
      "default": "Active"
    },
    "assignment_reason": {
      "type": "string",
      "title": "Assignment Reason"
    },
    "assignment_notes": {
      "type": "string",
      "title": "Assignment Notes"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "previous_assignment_id": {
      "type": "string",
      "title": "Previous Assignment"
    },
    "reassignment_flag": {
      "type": "boolean",
      "title": "Reassignment Flag",
      "default": false
    }
  },
  "required": [
    "household_id",
    "volunteer_team_id",
    "assigned_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    }
  }
}
{
  "name": "TeamTimelineEvent",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "title": "Volunteer Team"
    },
    "household_id": {
      "type": "string",
      "title": "Champion"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "Assignment Created",
        "Assignment Ended"
      ],
      "default": "Assignment Created"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "title": "Event Date"
    },
    "summary": {
      "type": "string",
      "title": "Summary"
    },
    "source_assignment_id": {
      "type": "string",
      "title": "Source Assignment"
    }
  },
  "required": [
    "team_id",
    "event_type",
    "event_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    }
  }
}
{
  "name": "StewardshipGuide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Relationship Building",
        "Volunteer Care",
        "Church Partnerships",
        "Events",
        "Spiritual Care",
        "Leadership Development",
        "Prayer",
        "Marriage Support"
      ],
      "default": "Relationship Building"
    },
    "situations": {
      "type": "array",
      "title": "Champion Situations",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "overview": {
      "type": "string",
      "title": "Overview"
    },
    "suggested_approaches": {
      "type": "array",
      "title": "Suggested Approaches",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "why_effective": {
            "type": "string",
            "title": "Why This Approach May Be Effective"
          },
          "when_it_works": {
            "type": "string",
            "title": "When It Works Well"
          },
          "when_to_consider_alternative": {
            "type": "string",
            "title": "When Another Approach Might Be Better"
          }
        }
      }
    },
    "conversation_ideas": {
      "type": "array",
      "title": "Conversation Starters",
      "items": {
        "type": "string"
      }
    },
    "prayer_prompts": {
      "type": "array",
      "title": "Prayer Prompts",
      "items": {
        "type": "string"
      }
    },
    "scriptures": {
      "type": "array",
      "title": "Scripture & Encouragement",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "encouragement": {
            "type": "string",
            "title": "Short Encouragement"
          }
        }
      }
    },
    "wisdom_callouts": {
      "type": "array",
      "title": "Ministry Wisdom Callouts",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Callout Label"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        }
      }
    },
    "suggested_communications": {
      "type": "array",
      "title": "Suggested Communications",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "template_id": {
            "type": "string",
            "title": "Template"
          },
          "template_title": {
            "type": "string",
            "title": "Template Title"
          }
        }
      }
    },
    "helpful_resources": {
      "type": "array",
      "title": "Helpful Resources",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "category": {
            "type": "string",
            "title": "Resource Category",
            "enum": [
              "Books",
              "Articles",
              "Videos",
              "Podcasts",
              "Downloadable Resources",
              "FamilyLife Materials"
            ],
            "default": "FamilyLife Materials"
          }
        }
      }
    },
    "things_to_remember": {
      "type": "array",
      "title": "Things to Remember",
      "items": {
        "type": "string"
      }
    },
    "reflection_questions": {
      "type": "array",
      "title": "Reflection Questions",
      "items": {
        "type": "string"
      }
    },
    "related_guides": {
      "type": "array",
      "title": "Related Guides (titles)",
      "items": {
        "type": "string"
      }
    },
    "display_order": {
      "type": "number",
      "title": "Display Order",
      "default": 100
    },
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": true
    },
    "archived": {
      "type": "boolean",
      "title": "Archived",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ChampionHousehold",
  "type": "object",
  "properties": {
    "household_name": {
      "type": "string",
      "title": "Household Name"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip_code": {
      "type": "string",
      "title": "Zip Code"
    },
    "home_phone": {
      "type": "string",
      "title": "Home Phone"
    },
    "area": {
      "type": "string",
      "title": "Area"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "title": "Registration Date"
    },
    "registration_type": {
      "type": "string",
      "title": "Registration Type",
      "enum": [
        "Individual",
        "Couple",
        "Group"
      ],
      "default": "Couple"
    },
    "group_name": {
      "type": "string",
      "title": "Group Name"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "First Contact",
        "Follow-Up",
        "Completed",
        "Inactive"
      ],
      "default": "New"
    },
    "assigned_volunteer": {
      "type": "string",
      "title": "Assigned Volunteer"
    },
    "assigned_director": {
      "type": "string",
      "title": "Assigned Director"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  }
}
{
  "name": "ChampionHousehold",
  "type": "object",
  "properties": {
    "household_name": {
      "type": "string",
      "title": "Household Name"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "address_line_2": {
      "type": "string",
      "title": "Address Line 2"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip_code": {
      "type": "string",
      "title": "Zip Code"
    },
    "home_phone": {
      "type": "string",
      "title": "Home Phone"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "area": {
      "type": "string",
      "title": "Area"
    },
    "church_name": {
      "type": "string",
      "title": "Church Name"
    },
    "church_city": {
      "type": "string",
      "title": "Church City"
    },
    "church_state": {
      "type": "string",
      "title": "Church State"
    },
    "church_zip_code": {
      "type": "string",
      "title": "Church ZIP Code"
    },
    "church_priority": {
      "type": "string",
      "title": "Church Priority",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "marriage_conference_priority": {
      "type": "string",
      "title": "Marriage Conference Priority",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "champion_status": {
      "type": "string",
      "title": "Champion Status",
      "enum": [
        "Active",
        "Inactive",
        "Prospect",
        "Alumni"
      ]
    },
    "do_not_call": {
      "type": "boolean",
      "title": "Do Not Call",
      "default": false
    },
    "do_not_text": {
      "type": "boolean",
      "title": "Do Not Text",
      "default": false
    },
    "email_opt_out": {
      "type": "boolean",
      "title": "Email Opt Out",
      "default": false
    },
    "cumulative_registrations": {
      "type": "number",
      "title": "Cumulative Registrations",
      "default": 0
    },
    "free_couple_registrations_used": {
      "type": "number",
      "title": "Free Couple Registrations Used",
      "default": 0
    },
    "free_couple_registrations_available": {
      "type": "number",
      "title": "Free Couple Registrations Available",
      "default": 0
    },
    "registrations_toward_next_free_registration": {
      "type": "number",
      "title": "Registrations Toward Next Free Registration",
      "default": 0
    },
    "registrations_needed_for_next_free_registration": {
      "type": "number",
      "title": "Registrations Needed for Next Free Registration",
      "default": 0
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "title": "Registration Date"
    },
    "registration_type": {
      "type": "string",
      "title": "Registration Type",
      "enum": [
        "Individual",
        "Couple",
        "Group"
      ],
      "default": "Couple"
    },
    "group_name": {
      "type": "string",
      "title": "Group Name"
    },
    "group_start_date": {
      "type": "string",
      "format": "date",
      "title": "Group Start Date"
    },
    "group_renewal_date": {
      "type": "string",
      "format": "date",
      "title": "Group Renewal Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "First Contact",
        "Follow-Up",
        "Completed",
        "Inactive"
      ],
      "default": "New"
    },
    "relationship_status": {
      "type": "string",
      "title": "Relationship Status",
      "enum": [
        "New",
        "Assigned",
        "First Contact Needed",
        "Attempted Contact",
        "Connected",
        "Following Up",
        "Registered for Weekend",
        "Attended Weekend",
        "Ongoing Champion",
        "Inactive"
      ],
      "default": "New"
    },
    "volunteer_team_id": {
      "type": "string",
      "title": "Assigned Volunteer Team"
    },
    "assigned_volunteer": {
      "type": "string",
      "title": "Assigned Volunteer"
    },
    "assigned_director": {
      "type": "string",
      "title": "Assigned Director"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": []
}
{
  "name": "AssignmentEvent",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "title": "Assignment"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "Created",
        "Updated",
        "Status Changed"
      ],
      "default": "Created"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "title": "Event Date"
    },
    "previous_value": {
      "type": "string",
      "title": "Previous Value"
    },
    "new_value": {
      "type": "string",
      "title": "New Value"
    },
    "summary": {
      "type": "string",
      "title": "Summary"
    }
  },
  "required": [
    "assignment_id",
    "event_type",
    "event_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    }
  }
}
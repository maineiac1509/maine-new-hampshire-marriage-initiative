{
  "name": "VolunteerTeam",
  "type": "object",
  "properties": {
    "team_name": {
      "type": "string",
      "title": "Team Name"
    },
    "family_name": {
      "type": "string",
      "title": "Family Name"
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "ministry_notes": {
      "type": "string",
      "title": "Ministry Notes"
    },
    "target_capacity": {
      "type": "number",
      "title": "Target Champion Capacity",
      "default": 12
    },
    "address": {
      "type": "string",
      "title": "Street Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip_code": {
      "type": "string",
      "title": "ZIP Code"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "travel_radius_miles": {
      "type": "number",
      "title": "Preferred Travel Radius (miles)",
      "default": 25
    },
    "coverage_regions": {
      "type": "string",
      "title": "Counties / Regions Served"
    },
    "coverage_notes": {
      "type": "string",
      "title": "Coverage Notes"
    }
  },
  "required": [
    "team_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    }
  }
}
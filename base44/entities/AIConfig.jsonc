{
  "name": "AIConfig",
  "type": "object",
  "properties": {
    "ai_enabled": {
      "type": "boolean",
      "title": "AI Enabled (Global Master Switch)",
      "default": false
    },
    "provider": {
      "type": "string",
      "title": "AI Provider",
      "default": "base44",
      "description": "Configuration-driven provider selection. Swapping providers requires only a config change \u2014 no code modifications."
    },
    "model": {
      "type": "string",
      "title": "Model Identifier",
      "default": "automatic"
    },
    "temperature": {
      "type": "number",
      "title": "Temperature",
      "default": 0.3
    },
    "max_tokens": {
      "type": "number",
      "title": "Maximum Output Tokens",
      "default": 2000
    },
    "timeout_ms": {
      "type": "number",
      "title": "Request Timeout (ms)",
      "default": 30000
    },
    "max_retries": {
      "type": "number",
      "title": "Maximum Retry Attempts",
      "default": 2
    },
    "max_context_size": {
      "type": "number",
      "title": "Maximum Context Size (characters)",
      "default": 50000
    },
    "context_reduction": {
      "type": "object",
      "title": "Intelligent Context Reduction Strategy",
      "description": "Configurable relevance-weighted strategy for keeping context within model limits. Evolves without changes to business logic.",
      "properties": {
        "recency_window_days": {
          "type": "number",
          "title": "Recency Window (days)",
          "default": 90,
          "description": "Records newer than this are always retained (Tier 2)."
        },
        "max_items_per_source": {
          "type": "number",
          "title": "Max Items Per Source",
          "default": 50,
          "description": "Initial retrieval cap per context source."
        },
        "summarize_older_records": {
          "type": "boolean",
          "title": "Summarize Older Records",
          "default": true,
          "description": "Deterministically aggregate older records into compact summaries before truncating (Tier 3)."
        },
        "hard_truncate_enabled": {
          "type": "boolean",
          "title": "Hard Truncation Enabled",
          "default": true,
          "description": "If context still exceeds limits after summarization, remove oldest non-priority items (Tier 4)."
        }
      },
      "default": {}
    },
    "feature_flags": {
      "type": "object",
      "title": "Feature Flags (scoped overrides)",
      "properties": {
        "global": {
          "type": "boolean",
          "title": "Global AI Enabled",
          "default": false
        },
        "organizations": {
          "type": "object",
          "title": "Organization-level Overrides",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "regions": {
          "type": "object",
          "title": "Region-level Overrides",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "churches": {
          "type": "object",
          "title": "Church-level Overrides",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "users": {
          "type": "object",
          "title": "User-level Overrides",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "default": {}
    },
    "updated_by": {
      "type": "string",
      "title": "Last Updated By"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "title": "Last Updated"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
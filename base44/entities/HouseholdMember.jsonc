{
  "name": "HouseholdMember",
  "type": "object",
  "properties": {
    "household_id": {
      "type": "string",
      "title": "Household ID"
    },
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "mobile_phone": {
      "type": "string",
      "title": "Mobile Phone"
    },
    "work_phone": {
      "type": "string",
      "title": "Work phone"
    },
    "relationship": {
      "type": "string",
      "title": "Relationship",
      "enum": [
        "Primary",
        "Spouse",
        "Member"
      ],
      "default": "Primary"
    },
    "import_creation_key": {
      "type": "string",
      "title": "Import Creation Key",
      "description": "Deterministic key linking this production member to the import batch and row that created it. Used for idempotent recovery after interruption."
    }
  },
  "required": [
    "household_id",
    "first_name",
    "last_name"
  ]
}